{
  "version": 3,
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#202228",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "FFFFFF",
          "name": "Background",
          "slug": "background"
        },
        {
          "color": "#C10230",
          "name": "Brand",
          "slug": "brand"
        },
        {
          "color": "#C10230",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#FFD800",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "#202228",
          "name": "Tertiary",
          "slug": "tertiary"
        },
        {
          "color": "#5C7482",
          "name": "Quaternary",
          "slug": "quaternary"
        },
        {
          "color": "#C2C3C8",
          "name": "Gris",
          "slug": "grey"
        },
        {
          "color": "#DADADA",
          "name": "Gris clair",
          "slug": "lightgrey"
        },
        {
          "color": "#f6f6f6",
          "name": "Gris très clair",
          "slug": "verylightgrey"
        },
        {
          "color": "#DEE0E3",
          "name": "Gris moyen",
          "slug": "mediumgrey"
        },
        {
          "color": "#323439",
          "name": "Gris foncé",
          "slug": "darkgrey"
        },
        {
          "color": "#000000",
          "name": "Black",
          "slug": "black"
        },
        {
          "color": "#FFFFFF",
          "name": "White",
          "slug": "white"
        }
      ]
    },
    "layout": {
      "contentSize": "960px",
      "wideSize": "1320px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "13px",
          "slug": "20"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "40"
        },
        {
          "name": "Regular",
          "size": "50px",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "70px",
          "slug": "60"
        },
        {
          "name": "X-Large",
          "size": "90px",
          "slug": "70"
        },
        {
          "name": "XX-Large",
          "size": "140px",
          "slug": "80"
        },
        {
          "name": "XXXLarge",
          "size": "180px",
          "slug": "90"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "src": [
                "file:./assets/fonts/Montserrat-VariableFont_wght.ttf"
              ]
            }
          ],
          "fontFamily": "Montserrat, sans-serif",
          "name": "Montserrat",
          "slug": "base"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "1.4rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1.8rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "2rem",
          "slug": "large"
        },
        {
          "name": "Extra Large",
          "size": "2.15rem",
          "slug": "x-large"
        }
      ],
      "writingMode": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "blocks": {
      "core/button": {
        "border": {
          "color": "var(--wp--preset--color--base)",
          "radius": "4px",
          "style": "solid",
          "width": "2px"
        },
        "color": {
          "text": "var(--wp--preset--color--base)"
        },
        "spacing": {
          "margin": {
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "0",
            "right": "0",
            "top": "var(--wp--preset--spacing--30)"
          },
          "padding": {
            "bottom": "17px",
            "left": "30px",
            "right": "30px",
            "top": "17px"
          }
        },
        "typography": {
          "fontSize": "1.2rem",
          "fontWeight": "700",
          "textTransform": "uppercase"
        }
      },
      "core/image": {
        "spacing": {
          "margin": {
            "top": "var(--wp--preset--spacing--50)"
          }
        },
        "elements": {
          "caption": {
            "typography": {
              "fontSize": "var(--wp--preset--font-size--small)",
              "lineHeight": "1.2"
            }
          }
        }
      },
      "core/columns": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--20)",
            "bottom": "var(--wp--preset--spacing--20)"
          }
        }
      },
      "core/list": {
        "css": "& li{margin-top: 0.5rem;}"
      },
      "core/navigation": {
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/post-navigation-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/post-terms": {
        "css": "& a { white-space: nowrap; }",
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600"
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/pullquote": {
        "css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--30);}",
        "elements": {
          "cite": {
            "typography": {
              "fontSize": "var(--wp--preset--font-size--small)",
              "fontStyle": "normal"
            }
          }
        },
        "spacing": {
          "padding": {
            "bottom": "var(--wp--preset--spacing--30)",
            "top": "var(--wp--preset--spacing--30)"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "300",
          "lineHeight": "1.2"
        }
      },
      "core/query-pagination": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "500"
        }
      },
      "core/quote": {
        "border": {
          "color": "currentColor",
          "style": "solid",
          "width": "0 0 0 3px"
        },
        "elements": {
          "cite": {
            "css": "& sub { font-size: 0.65em }",
            "typography": {
              "fontSize": "var(--wp--preset--font-size--small)",
              "fontStyle": "normal",
              "fontWeight": "300"
            }
          }
        },
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--30)",
          "margin": {
            "left": "0",
            "right": "0"
          },
          "padding": {
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "var(--wp--preset--spacing--40)",
            "right": "var(--wp--preset--spacing--40)",
            "top": "var(--wp--preset--spacing--30)"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "300"
        },
        "variations": {
          "plain": {
            "border": {
              "color": "transparent",
              "radius": "0",
              "style": "none",
              "width": "0"
            },
            "spacing": {
              "padding": {
                "bottom": "0",
                "left": "0",
                "right": "0",
                "top": "0"
              }
            }
          }
        }
      },
      "core/search": {
        "css": "& .wp-block-search__input{border-radius:3.125rem;padding-left:1.5625rem;padding-right:1.5625rem;border-color:var(--wp--preset--color--primary);}",
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.6"
        }
      },
      "core/separator": {
        "border": {
          "color": "currentColor",
          "style": "solid",
          "width": "0 0 1px 0"
        },
        "color": {
          "text": "var(--wp--preset--color--accent-6)"
        },
        "variations": {
          "wide": {
            "css": " &:not(.alignfull){max-width: var(--wp--style--global--wide-size) !important;}"
          }
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/site-title": {
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontWeight": "700",
          "letterSpacing": "-.5px"
        }
      },
      "core/term-description": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/comment-author-name": {
        "color": {
          "text": "var(--wp--preset--color--quaternary)"
        },
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "color": {
              "text": "var(--wp--preset--color--quaternary)"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "spacing": {
          "margin": {
            "bottom": "0px",
            "top": "5px"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/comment-content": {
        "spacing": {
          "margin": {
            "bottom": "var(--wp--preset--spacing--30)",
            "top": "var(--wp--preset--spacing--30)"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/comment-date": {
        "color": {
          "text": "var(--wp--preset--color--background)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--background)"
            }
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/comment-edit-link": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--background)"
            }
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/comment-reply-link": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--background)"
            }
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    },
    "border": {
      "radius": "12px"
    },
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--base)"
    },
    "elements": {
      "h1": {
        "color": {
          "text": "var(--wp--preset--color--base)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--base)",
          "fontSize": "clamp(2.5rem, 5vw, 3.8rem)",
          "fontWeight": "300",
          "lineHeight": "1",
          "textTransform": "uppercase"
        }
      },
      "h2": {
        "color": {
          "text": "var(--wp--preset--color--base)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--base)",
          "fontSize": "clamp(2.4rem, 4vw, 3rem)",
          "fontWeight": "300",
          "lineHeight": "1.3"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        }
      }
    },
    "spacing": {
      "blockGap": "1.6rem",
      "padding": {
        "bottom": "0",
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)",
        "top": "0"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--base)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontWeight": "400",
      "letterSpacing": "-0.1px",
      "lineHeight": "1.8"
    }
  }
}
