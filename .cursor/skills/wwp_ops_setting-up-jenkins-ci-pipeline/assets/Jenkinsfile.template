import groovy.json.JsonSlurperClassic

@NonCPS
def parseJsonToMap(String json) {
    final slurper = new JsonSlurperClassic()
    return new HashMap<>(slurper.parseText(json))
}

def sshPortFlag(creds) {
    return (creds.sshPort && creds.sshPort.toString() != '22') ? "-p ${creds.sshPort}" : ''
}

def rsyncSshCommand(creds) {
    def portFlag = sshPortFlag(creds)
    return portFlag ? "ssh ${portFlag}" : 'ssh'
}

def sshRemoteSh(sshBase, remoteCommand, timeoutSeconds = 60, returnStdout = false) {
    def shellScript = """${sshBase} /bin/bash -s <<'JENKINS_REMOTE_EOF'
set -e
${remoteCommand}
JENKINS_REMOTE_EOF
"""
    def output = null
    timeout(time: timeoutSeconds, unit: 'SECONDS') {
        if (returnStdout) {
            output = sh(returnStdout: true, script: shellScript)
        } else {
            sh(script: shellScript)
        }
    }
    return output
}

def loadCreds(secretFile){
    withCredentials([file(credentialsId: secretFile, variable: 'MY_SECRET_FILE')]) {
        script {
            MY_SECRET_FILE_CONTENT = sh (
                script: "cat ${MY_SECRET_FILE}",
                returnStdout: true
            ).trim()
            return parseJsonToMap(MY_SECRET_FILE_CONTENT)
        }
    }
}

def handleException(msg,exc) {
    def changeString_ = getChangeString()+"\n";

    if(msg){
		changeString_ += msg;
    } else {
    	changeString_ += " - Build failed. ";
    }

    if(exc){
    	changeString_ += " | ";
    	changeString_ += exc.getMessage();
    }

    changeString_ +="\n<${env.RUN_DISPLAY_URL}|Voir le build>";

    if(env.siteUrl){
      changeString_+="\n"+'<'+env.siteUrl+'|Voir le site>';
    }

	notify(changeString_,"danger");
	if(exc){
		throw(exc);
	}
}

